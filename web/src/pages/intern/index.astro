---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { festDateLabel, currentPhase, FEST_PHASES } from '../../lib/ifbFest';

const phase = currentPhase();
const phaseNumber = FEST_PHASES.findIndex((p) => p.id === phase.id) + 1;
---

<BaseLayout title="Interner Bereich | Zukunft bauen">
  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <h1 class="font-serif text-3xl font-bold text-haw-blau mb-2">Interner Bereich</h1>
    <div class="haw-gradient-line w-12 mb-6"></div>
    <p class="text-haw-blau-70 mb-10">
      Die Arbeitsbereiche zu unseren Veranstaltungen. Für den Zugang brauchen Sie einen
      Login-Link – den bekommen Sie im jeweiligen Bereich.
    </p>

    <!-- Aktuelle Veranstaltung -->
    <h2 class="text-sm font-bold tracking-widest text-haw-blau-50 uppercase mb-3">Aktuell</h2>
    <a
      href="/intern/10-jahre-ifb"
      class="block border-2 border-haw-blau rounded-lg p-6 mb-10 hover:bg-haw-blau-10 transition-colors"
    >
      <div class="flex flex-wrap items-start justify-between gap-3 mb-2">
        <h3 class="font-serif text-2xl font-bold text-haw-blau">10 Jahre Institut für Bauwesen</h3>
        <span class="text-xs font-bold px-3 py-1 rounded bg-haw-blau text-white whitespace-nowrap">
          Phase {phaseNumber} – {phase.label}
        </span>
      </div>
      <p class="text-haw-blau-70 text-sm mb-3">{festDateLabel()}</p>
      <p class="text-haw-blau-70 text-sm">
        Gäste vorschlagen, Referent:innen benennen und herausragende Abschlussarbeiten des
        Jahrzehnts einreichen.
      </p>
      <p class="text-haw-blau font-bold text-sm mt-4">Zum Fest-Bereich →</p>
    </a>

    <!-- Archiv -->
    <h2 class="text-sm font-bold tracking-widest text-haw-blau-50 uppercase mb-3">
      Vergangene Veranstaltungen
    </h2>
    <a
      href="/intern/silos-aufbrechen-2026"
      class="block border border-haw-blau-30 rounded-lg p-6 hover:border-haw-blau transition-colors"
    >
      <div class="flex flex-wrap items-start justify-between gap-3 mb-2">
        <h3 class="font-serif text-xl font-bold text-haw-blau">Silos aufbrechen – Zukunft bauen</h3>
        <span
          class="text-xs font-bold px-3 py-1 rounded bg-haw-blau-10 text-haw-blau-50 whitespace-nowrap"
        >
          Abgeschlossen
        </span>
      </div>
      <p class="text-haw-blau-70 text-sm mb-3">7. Mai 2026</p>
      <p class="text-haw-blau-70 text-sm">
        Teilnehmendenliste, Themengebiete und Forschungsmöglichkeiten der Veranstaltung.
      </p>
      <p class="text-haw-blau font-bold text-sm mt-4">Zum Archivbereich →</p>
    </a>
  </section>
</BaseLayout>

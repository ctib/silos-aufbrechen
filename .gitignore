node_modules/

# Astro build output
web/dist/
web/.astro/

# Environment variables
.env
.env.*
!.env.example

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Licensed fonts (not to be committed)
Fonts/

# Claude Code config
.claude/

# Lokale Daten (nicht ins Repo)
Anmeldungen/
Archiv/
